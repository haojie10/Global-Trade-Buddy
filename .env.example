# ============================================================
# GlobalTradeBuddy 环境变量示例配置文件 (.env.example)
# ============================================================

# 1. 站点与 Agent 自动上传配置
GTB_API_URL=http://127.0.0.1:3000
AGENT_API_KEY=your_agent_api_key
SERPAPI_API_KEY=your_serpapi_key

# 2. 数据库与 Session 安全配置
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/globaltradebuddy
TEST_DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/globaltradebuddy_test
SESSION_SECRET=your_random_session_secret

# 3. 腾讯云 COS 对象存储配置
COS_SECRET_ID=your_tencent_secret_id
COS_SECRET_KEY=your_tencent_secret_key
COS_BUCKET=marketgraphic-image-1302276463
COS_REGION=ap-shanghai

# 4. SMTP 邮件服务配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code
