# ============================================================
# 数据库配置（支持 腾讯云轻量服务器自建 PostgreSQL 或 Supabase PostgreSQL）
# ============================================================

# 应用运行主数据库连接 URL (替换为你的轻量服务器 IP、端口、账号、密码及数据库名)
# 格式: postgresql://<username>:<password>@<your-server-ip>:5432/<dbname>?sslmode=disable
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/globaltradebuddy

# 自动化测试使用的数据库连接 URL
TEST_DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/globaltradebuddy_test

# Session 签名密钥（HMAC-SHA256），生产环境必须设置为随机长字符串
# 可通过命令生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ============================================================
# 腾讯云 COS 对象存储配置
# ============================================================
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=marketgraphic-image-1302276463
COS_REGION=ap-shanghai
COS_DOMAIN=

# ============================================================
# 腾讯云 CloudBase 云开发与云存储配置 (兼容备用)
# ============================================================

# CloudBase 环境 ID（在腾讯云云开发控制台页面左上角查看），示例: marketgraphic-d1g82tv7y3a8c6800
TCB_ENV_ID=

# 腾讯云 API 密钥 CAM (访问 https://console.cloud.tencent.com/cam/capi 获取)
# 注意: 云托管 CloudRun 容器内运行时可留空（会自动获取内置凭证）；本地开发/轻量服务器部署必须填写
TCB_SECRET_ID=
TCB_SECRET_KEY=

# CloudBase 存储桶名称（可选），示例: marketgraphic-images
# 用于构造 fileID: cloud://<env>.<bucket>/<path>；留空则默认使用 cloud://<env>/<path>
TCB_BUCKET=

# ============================================================
# Supabase（历史数据兼容项，如使用自建 Postgres 则无需配置）
# ============================================================

# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=


