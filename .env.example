# ============================================================
# Database（Supabase PostgreSQL，保持不变）
# ============================================================

# Database connection URL for standard app execution (development and production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Database connection URL for running automated tests
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Session 签名密钥（HMAC-SHA256），生产环境必须设置为随机长字符串
# 可通过 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成
SESSION_SECRET=

# ============================================================
# CloudBase 云存储（生产环境图片存储，优先级最高）
# ============================================================

# CloudBase 环境 ID（云存储页面左上角可见），如 marketgraphic-d1g82tv7y3a8c6800
TCB_ENV_ID=

# 腾讯云 API 密钥（访问 https://console.cloud.tencent.com/cam/capi 获取）
# 云托管 CloudRun 容器内运行时可不填（自动获取内置凭证）；本地开发必须填
TCB_SECRET_ID=
TCB_SECRET_KEY=

# CloudBase 存储桶名（可选），如 marketgraphic-images
# 用于构造 fileID：cloud://<env>.<bucket>/<path>；留空则使用默认桶 cloud://<env>/<path>
TCB_BUCKET=

# ============================================================
# Supabase（仅用于兼容旧存储数据；数据库连接见上方 DATABASE_URL）
# ============================================================

# Supabase 项目 URL 与密钥（旧图片数据在 Supabase Storage 时用于清理）
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
