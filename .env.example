# ============================================================
# GlobalTradeBuddy 环境变量示例配置文件 (.env.example)
# 架构：腾讯云轻量服务器 + 自建 PostgreSQL + 腾讯云 COS + SMTP
# ============================================================

# ────────────────────────────────────────────────────────────
# 1. 站点与 Agent 自动上传配置
# ────────────────────────────────────────────────────────────
GTB_API_URL=https://marketgraphic.cn
NEXT_PUBLIC_SITE_URL=https://marketgraphic.cn
AGENT_API_KEY=your_automation_agent_secret
SERPAPI_API_KEY=your_serpapi_key

# ────────────────────────────────────────────────────────────
# 2. 数据库与 Session 安全配置 (自建 PostgreSQL)
# ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/postgres
TEST_DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/postgres_test
SESSION_SECRET=your_32_byte_hex_session_secret

# ────────────────────────────────────────────────────────────
# 3. 腾讯云 COS 对象存储配置 (图片与研报存储)
# ────────────────────────────────────────────────────────────
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=marketgraphic-image-1302276463
COS_REGION=ap-shanghai

# ────────────────────────────────────────────────────────────
# 4. SMTP 邮件服务配置 (用于发送验证码与接收管理员通知)
# ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code
# 管理员接收用户定制/反馈提醒的邮箱（若不填，默认自动发到上面的 SMTP_USER）
ADMIN_NOTIFICATION_EMAIL=your_personal_email@qq.com
